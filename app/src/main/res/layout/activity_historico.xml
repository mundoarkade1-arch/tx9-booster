<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hist_titulo"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtHistoricoEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/hist_carregando"
        android:textColor="#FFEB3B"
        android:textSize="18sp" />

    <ListView
        android:id="@+id/listaHistorico"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:choiceMode="singleChoice"
        android:divider="#37474F"
        android:dividerHeight="1dp"
        android:focusable="true" />

    <Button
        android:id="@+id/btnReverterHistorico"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/botao_fundo"
        android:enabled="false"
        android:focusable="true"
        android:text="@string/hist_reverter"
        android:textColor="#FFFFFF"
        android:textSize="22sp" />

    <Button
        android:id="@+id/btnAtualizarHistorico"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/botao_fundo"
        android:focusable="true"
        android:text="@string/hist_atualizar"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

</LinearLayout>