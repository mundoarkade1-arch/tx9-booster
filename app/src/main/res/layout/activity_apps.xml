<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/apps_titulo"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/apps_aviso"
        android:textColor="#B0BEC5"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnFiltroApps"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/botao_fundo"
        android:focusable="true"
        android:text="@string/apps_filtro_usuario"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/txtTotalApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/apps_carregando"
        android:textColor="#FFEB3B"
        android:textSize="18sp" />

    <ListView
        android:id="@+id/listaApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#37474F"
        android:dividerHeight="1dp"
        android:focusable="true" />

</LinearLayout>
